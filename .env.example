# Plantilla de variables de entorno — copiar a .env y llenar con valores
# reales. .env nunca se versiona (ver .gitignore).

# Token del bot de @BotFather (@Cazagangasmxbot).
TELEGRAM_BOT_TOKEN=

# ID numérico del canal donde se publica (el bot debe ser admin ahí).
TELEGRAM_CHANNEL_ID=

# Username del canal (sin @), para armar el link t.me/<username>/<id>.
TELEGRAM_CHANNEL_USERNAME=

# IDs de Telegram con permiso de mandar publicaciones, separados por coma.
TELEGRAM_ALLOWED_IDS=

# Dueño del bot: aprueba solicitudes de acceso por código y puede usar
# /usuarios y /quitar <id>.
TELEGRAM_OWNER_ID=

# Credenciales del owner de n8n (primer usuario). scripts/setup.sh las usa
# para crear el owner por API si todavía no existe (idempotente).
N8N_OWNER_EMAIL=
N8N_OWNER_PASSWORD=

# Secret que Telegram manda en el header X-Telegram-Bot-Api-Secret-Token y
# que el workflow valida. scripts/setup.sh lo genera solo si falta.
TELEGRAM_WEBHOOK_SECRET=
